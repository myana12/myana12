import React, { useState } from "react";

const AppointmentBooking = () => {
  const [selectedDate, setSelectedDate] = useState("");
  const [bookedSlots, setBookedSlots] = useState({});
  const [confirmationMessage, setConfirmationMessage] = useState("");

  const timeSlots = [
    "09:00 AM", "09:30 AM", "10:00 AM", "10:30 AM",
    "11:00 AM", "11:30 AM", "12:00 PM", "12:30 PM",
    "01:00 PM", "01:30 PM", "02:00 PM", "02:30 PM"
  ];

  const handleDateChange = (e) => {
    setSelectedDate(e.target.value);
    setConfirmationMessage("");
  };

  const handleBookSlot = (slot, isAdmin = false) => {
    const updatedSlots = { ...bookedSlots };
    if (!updatedSlots[selectedDate]) {
      updatedSlots[selectedDate] = [];
    }
    if (!updatedSlots[selectedDate].includes(slot)) {
      updatedSlots[selectedDate].push(slot);
      setBookedSlots(updatedSlots);
      setConfirmationMessage(
        isAdmin
          ? `Admin booked ${slot} on ${selectedDate}`
          : `You successfully booked ${slot} on ${selectedDate}`
      );
    } else {
      setConfirmationMessage("Slot already booked.");
    }
  };

  const isSlotBooked = (slot) =>
    bookedSlots[selectedDate] && bookedSlots[selectedDate].includes(slot);

  return (
    <div style={{ padding: "20px", fontFamily: "Arial" }}>
      <h2>📅 Book Appointment</h2>
      <input type="date" value={selectedDate} onChange={handleDateChange} />

      {selectedDate && (
        <>
          <h3>Available Slots for {selectedDate}</h3>
          <ul style={{ listStyle: "none", padding: 0 }}>
            {timeSlots.map((slot) => (
              <li key={slot} style={{ margin: "10px 0" }}>
                <span>{slot}</span>
                {" - "}
                <button
                  onClick={() => handleBookSlot(slot)}
                  disabled={isSlotBooked(slot)}
                >
                  Book
                </button>
                {" "}
                <button
                  onClick={() => handleBookSlot(slot, true)}
                  disabled={isSlotBooked(slot)}
                  style={{ backgroundColor: "orange", color: "white" }}
                >
                  Admin Book
                </button>
                {isSlotBooked(slot) && <span style={{ color: "red" }}> (Booked)</span>}
              </li>
            ))}
          </ul>
        </>
      )}

      {confirmationMessage && (
        <div style={{ marginTop: "20px", color: "green" }}>
          ✅ {confirmationMessage}
        </div>
      )}
    </div>
  );
};

export default AppointmentBooking;
